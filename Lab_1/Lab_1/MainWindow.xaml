<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lab_1.ViewModels"
        Title="{Binding Translations[AppTitle]}" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="{Binding SelectedFontFamily}"
        FontSize="{Binding FontSize}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <XmlDataProvider x:Key="PrimaryColors">
            <x:XData>
                <Colors xmlns="">
                    <Color Hex="#E3F2FD" RGB="227, 242, 253" Name="Основной 50"/>
                    <Color Hex="#BBDEFB" RGB="187, 222, 251" Name="Основной 100"/>
                    <Color Hex="#90CAF9" RGB="144, 202, 249" Name="Основной 200"/>
                    <Color Hex="#64B5F6" RGB="100, 181, 246" Name="Основной 300"/>
                    <Color Hex="#42A5F5" RGB="66, 165, 245" Name="Основной 400"/>
                    <Color Hex="#2196F3" RGB="33, 150, 243" Name="Основной 500 (Базовый)"/>
                    <Color Hex="#1E88E5" RGB="30, 136, 229" Name="Основной 600"/>
                    <Color Hex="#1976D2" RGB="25, 118, 210" Name="Основной 700"/>
                    <Color Hex="#1565C0" RGB="21, 101, 192" Name="Основной 800"/>
                    <Color Hex="#0D47A1" RGB="13, 71, 161" Name="Основной 900"/>
                </Colors>
            </x:XData>
        </XmlDataProvider>

        <XmlDataProvider x:Key="TreeData">
            <x:XData>
                <Tree xmlns="">
                    <Node Name="Элементы управления">
                        <Node Name="Кнопки">
                            <Node Name="Button"/>
                            <Node Name="ToggleButton"/>
                        </Node>
                        <Node Name="Поля ввода">
                            <Node Name="TextBox"/>
                            <Node Name="PasswordBox"/>
                        </Node>
                    </Node>
                    <Node Name="Контейнеры">
                        <Node Name="StackPanel"/>
                        <Node Name="Grid"/>
                        <Node Name="Canvas"/>
                    </Node>
                </Tree>
            </x:XData>
        </XmlDataProvider>

        <XmlDataProvider x:Key="DemoGridData">
            <x:XData>
                <Items xmlns="">
                    <Item Name="Button" Description="Обычная кнопка" Status="Активна"/>
                    <Item Name="TextBox" Description="Поле ввода текста" Status="Пустое"/>
                    <Item Name="ComboBox" Description="Раскрывающийся список" Status="Выбрано"/>
                    <Item Name="CheckBox" Description="Флажок" Status="Отмечен"/>
                </Items>
            </x:XData>
        </XmlDataProvider>
    </Window.Resources>

    <DockPanel>

        <!-- ГЛАВНОЕ МЕНЮ (Файл / Правка / Справка) -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding Translations[FileMenu]}">
                <MenuItem Header="{Binding Translations[Open]}" 
                  Command="{Binding OpenCommand}" 
                  InputGestureText="Ctrl+O"/>
                <MenuItem Header="{Binding Translations[Save]}" 
                  Command="{Binding SaveCommand}" 
                  InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="{Binding Translations[Exit]}" 
                  Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{Binding Translations[EditMenu]}">
                <MenuItem Header="{Binding Translations[Undo]}" 
                  Command="{Binding UndoCommand}" 
                  InputGestureText="Ctrl+Z"/>
                <MenuItem Header="{Binding Translations[Redo]}" 
                  Command="{Binding RedoCommand}" 
                  InputGestureText="Ctrl+Y"/>
            </MenuItem>
            <MenuItem Header="{Binding Translations[HelpMenu]}">
                <MenuItem Header="{Binding Translations[About]}" 
                  Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>
        <!-- Панель инструментов -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="{Binding Translations[Copy]}" Command="{Binding CopyCommand}" Style="{DynamicResource ToolBarButtonStyle}"/>
                <Button Content="{Binding Translations[Paste]}" Command="{Binding PasteCommand}" Style="{DynamicResource ToolBarButtonStyle}"/>
            </ToolBar>
        </ToolBarTray>

        <TabControl Margin="10">

            <!-- ВКЛАДКА 1: Основное -->
            <TabItem Header="{Binding Translations[TabMain]}">
                <ScrollViewer>
                    <StackPanel Margin="15">
                        <GroupBox Header="{Binding Translations[PersonalizationSettings]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding Translations[ThemeLabel]}" Style="{DynamicResource LabelStyle}"/>
                                <ComboBox Text="{Binding SelectedTheme, Mode=TwoWay}" Style="{DynamicResource AppInputStyle}">
                                    <ComboBoxItem Content="{Binding Translations[LightTheme]}"/>
                                    <ComboBoxItem Content="{Binding Translations[DarkTheme]}"/>
                                </ComboBox>

                                <TextBlock Text="{Binding Translations[LanguageLabel]}" Style="{DynamicResource LabelStyle}"/>
                                <ComboBox Text="{Binding SelectedLanguage, Mode=TwoWay}" Style="{DynamicResource AppInputStyle}">
                                    <ComboBoxItem Content="{Binding Translations[Russian]}"/>
                                    <ComboBoxItem Content="{Binding Translations[English]}"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[FontSettings]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="{Binding Translations[FontLabel]}" Style="{DynamicResource LabelStyle}"/>
                                <!-- Привязка шрифта через SelectedValue + SelectedValuePath -->
                                <ComboBox SelectedValue="{Binding SelectedFontFamily, Mode=TwoWay}"
                              SelectedValuePath="Content"
                              Style="{DynamicResource AppInputStyle}">
                                    <ComboBoxItem Content="Segoe UI"/>
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                    <ComboBoxItem Content="Consolas"/>
                                    <ComboBoxItem Content="Verdana"/>
                                </ComboBox>

                                <TextBlock Text="{Binding Translations[FontSizeLabel]}" Style="{DynamicResource LabelStyle}"/>
                                <Slider Minimum="10" Maximum="24" Value="{Binding FontSize, Mode=TwoWay}"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                                <!-- Локализованный текст через вычисляемое свойство -->
                                <TextBlock Text="{Binding CurrentFontSizeText}"
                               HorizontalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 2: Цветовая палитра -->
            <TabItem Header="{Binding Translations[TabPalette]}">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentThemeText}" Style="{DynamicResource HeaderTextBlockStyle}"/>

                        <GroupBox Header="{Binding Translations[MainColors]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{DynamicResource PrimaryBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="{Binding Translations[Primary]}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{DynamicResource AccentBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="{Binding Translations[Accent]}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{DynamicResource SuccessBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="{Binding Translations[Success]}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{DynamicResource ErrorBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="{Binding Translations[Error]}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{DynamicResource InfoBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="{Binding Translations[Info]}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[ColorPalette]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <ItemsControl ItemsSource="{Binding Source={StaticResource PrimaryColors}, XPath=Colors/Color}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{Binding XPath=@Hex}" Width="60" Height="30" Stroke="Gray" RadiusX="3" RadiusY="3"/>
                                            <TextBlock Text="{Binding XPath=@RGB}" Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            <TextBlock Text="{Binding XPath=@Name}" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 3: Элементы управления -->
            <TabItem Header="{Binding Translations[TabControls]}">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <Expander Header="{Binding Translations[Buttons]}" IsExpanded="True" Margin="0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <Button Content="{Binding Translations[NormalButton]}" Style="{DynamicResource PrimaryButtonStyle}" ToolTip="Всплывающая подсказка"/>
                                <Button Content="{Binding Translations[SuccessButton]}" Style="{DynamicResource SuccessButtonStyle}"/>
                                <Button Content="{Binding Translations[DeleteButton]}" Style="{DynamicResource DangerButtonStyle}"/>
                                <ToggleButton Content="{Binding Translations[ToggleButton]}" Style="{DynamicResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding Translations[InputFields]}" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10">
                                <TextBox Text="TextBox: введите текст" Style="{DynamicResource AppInputStyle}"/>
                                <PasswordBox Password="secret" Padding="6,4" Margin="0,0,0,10" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Text="ComboBox" IsEditable="True" Width="200" Margin="0,0,10,0" Style="{DynamicResource AppInputStyle}"/>
                                    <ListBox Width="200" Height="60">
                                        <ListBoxItem Content="Элемент 1"/>
                                        <ListBoxItem Content="Элемент 2"/>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding Translations[TextElements]}" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10">
                                <TextBlock Text="Заголовок уровня 1" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                                <TextBlock Text="Заголовок уровня 2" FontSize="20" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Text="Обычный текст в TextBlock." Margin="0,5"/>
                                <Label Content="Подпись в Label" BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,5"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding Translations[TreeViewDataGrid]}" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10">
                                <TreeView Height="120" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10"
                                          ItemsSource="{Binding Source={StaticResource TreeData}, XPath=Tree/Node}">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding XPath=Node}">
                                            <TextBlock Text="{Binding XPath=@Name}"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <DataGrid Height="120" AutoGenerateColumns="False" IsReadOnly="True"
                                          ItemsSource="{Binding Source={StaticResource DemoGridData}, XPath=Items/Item}"
                                          Style="{DynamicResource AppDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Название" Binding="{Binding XPath=@Name}" Width="*"/>
                                        <DataGridTextColumn Header="Описание" Binding="{Binding XPath=@Description}" Width="2*"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding XPath=@Status}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding Translations[ProgressBar]}" IsExpanded="False" Margin="0,5">
                            <StackPanel Margin="10">
                                <ProgressBar Value="65" Height="25" Margin="0,5" Maximum="100"/>
                                <TextBlock Text="{Binding Translations[ProgressText]}" HorizontalAlignment="Center" Margin="0,5"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 4: Контейнеры компоновки -->
            <TabItem Header="{Binding Translations[TabLayouts]}">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <GroupBox Header="{Binding Translations[StackPanelVertical]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Margin="10" Background="{DynamicResource SecondaryBackgroundBrush}">
                                <Rectangle Fill="{DynamicResource ErrorBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource SuccessBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource PrimaryBrush}" Width="60" Height="40" Margin="2"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[StackPanelHorizontal]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Orientation="Horizontal" Margin="10" Background="{DynamicResource SecondaryBackgroundBrush}">
                                <Rectangle Fill="{DynamicResource ErrorBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource SuccessBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource PrimaryBrush}" Width="60" Height="40" Margin="2"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[WrapPanel]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <WrapPanel Margin="10" Background="{DynamicResource SecondaryBackgroundBrush}">
                                <Rectangle Fill="{DynamicResource ErrorBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource SuccessBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource PrimaryBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource AccentBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{DynamicResource InfoBrush}" Width="80" Height="40" Margin="2"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[DockPanel]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <DockPanel Margin="10" Background="{DynamicResource SecondaryBackgroundBrush}" Height="140">
                                <Rectangle Fill="{DynamicResource ErrorBrush}" Width="60" DockPanel.Dock="Left" Margin="2"/>
                                <Rectangle Fill="{DynamicResource SuccessBrush}" Height="40" DockPanel.Dock="Top" Margin="2"/>
                                <Rectangle Fill="{DynamicResource PrimaryBrush}" Height="40" DockPanel.Dock="Bottom" Margin="2"/>
                                <Rectangle Fill="{DynamicResource AccentBrush}" Margin="2"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[Grid]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <Grid Margin="10" Background="{DynamicResource SecondaryBackgroundBrush}" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{DynamicResource ErrorBrush}" Grid.Row="0" Grid.Column="0" Margin="2"/>
                                <Rectangle Fill="{DynamicResource SuccessBrush}" Grid.Row="0" Grid.Column="1" Margin="2"/>
                                <Rectangle Fill="{DynamicResource PrimaryBrush}" Grid.Row="1" Grid.Column="0" Margin="2"/>
                                <Rectangle Fill="{DynamicResource AccentBrush}" Grid.Row="1" Grid.Column="1" Margin="2"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[Canvas]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <Canvas Margin="10" Background="{DynamicResource SecondaryBackgroundBrush}" Height="140">
                                <Rectangle Fill="{DynamicResource ErrorBrush}" Width="60" Height="40" Canvas.Left="20" Canvas.Top="20"/>
                                <Rectangle Fill="{DynamicResource SuccessBrush}" Width="60" Height="40" Canvas.Left="100" Canvas.Top="50"/>
                                <Rectangle Fill="{DynamicResource PrimaryBrush}" Width="60" Height="40" Canvas.Left="60" Canvas.Top="90"/>
                            </Canvas>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 5: Таблицы и Команды -->
            <TabItem Header="{Binding Translations[TabTables]}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="{Binding Translations[SourceTable]}" Grid.Column="0" Style="{DynamicResource AppGroupBoxStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Content="{Binding Translations[Add]}" Command="{Binding AddCommand}" Style="{DynamicResource SuccessButtonStyle}"/>
                                <Button Content="{Binding Translations[Delete]}" Command="{Binding DeleteCommand}" Style="{DynamicResource DangerButtonStyle}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding SourceItems}"
                                      SelectedItem="{Binding SelectedSourceItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{DynamicResource AppDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Translations[NameColumn]}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="{Binding Translations[DescriptionColumn]}" Binding="{Binding Description}" Width="2*"/>
                                    <DataGridTextColumn Header="{Binding Translations[StatusColumn]}" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding Translations[TargetTable]}" Grid.Column="1" Style="{DynamicResource AppGroupBoxStyle}">
                        <DataGrid ItemsSource="{Binding TargetItems}"
                                  SelectedItem="{Binding SelectedTargetItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource AppDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding Translations[NameColumn]}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{Binding Translations[DescriptionColumn]}" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="{Binding Translations[StatusColumn]}" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 6: Типы привязок -->
            <TabItem Header="{Binding Translations[TabBindings]}">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <TextBlock Text="{Binding Translations[BindingDemo]}" Style="{DynamicResource HeaderTextBlockStyle}"/>

                        <GroupBox Header="{Binding Translations[PropertyChanged]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBox Text="{Binding BindingPropertyChanged, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource AppInputStyle}"/>
                                <TextBlock Text="{Binding BindingPropertyChanged}" FontStyle="Italic" Foreground="Gray"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[LostFocus]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBox Text="{Binding BindingLostFocus, UpdateSourceTrigger=LostFocus}" Style="{DynamicResource AppInputStyle}"/>
                                <TextBlock Text="{Binding BindingLostFocus}" FontStyle="Italic" Foreground="Gray"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{Binding Translations[Explicit]}" Style="{DynamicResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBox Text="{Binding BindingExplicit, UpdateSourceTrigger=Explicit}" Style="{DynamicResource AppInputStyle}"/>
                                <Button Content="{Binding Translations[UpdateExplicit]}" Command="{Binding UpdateExplicitCommand}"
                                        Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>