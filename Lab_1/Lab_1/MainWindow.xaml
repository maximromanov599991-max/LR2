<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lab_1.ViewModels"
        Title="Лабораторная работа 2 - WPF MVVM" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Данные для цветовой палитры -->
        <XmlDataProvider x:Key="PrimaryColors">
            <x:XData>
                <Colors xmlns="">
                    <Color Hex="#E3F2FD" RGB="227, 242, 253" Name="Основной 50"/>
                    <Color Hex="#BBDEFB" RGB="187, 222, 251" Name="Основной 100"/>
                    <Color Hex="#90CAF9" RGB="144, 202, 249" Name="Основной 200"/>
                    <Color Hex="#64B5F6" RGB="100, 181, 246" Name="Основной 300"/>
                    <Color Hex="#42A5F5" RGB="66, 165, 245" Name="Основной 400"/>
                    <Color Hex="#2196F3" RGB="33, 150, 243" Name="Основной 500 (Базовый)"/>
                    <Color Hex="#1E88E5" RGB="30, 136, 229" Name="Основной 600"/>
                    <Color Hex="#1976D2" RGB="25, 118, 210" Name="Основной 700"/>
                    <Color Hex="#1565C0" RGB="21, 101, 192" Name="Основной 800"/>
                    <Color Hex="#0D47A1" RGB="13, 71, 161" Name="Основной 900"/>
                </Colors>
            </x:XData>
        </XmlDataProvider>

        <!-- Данные для TreeView -->
        <XmlDataProvider x:Key="TreeData">
            <x:XData>
                <Tree xmlns="">
                    <Node Name="Элементы управления">
                        <Node Name="Кнопки">
                            <Node Name="Button"/>
                            <Node Name="ToggleButton"/>
                        </Node>
                        <Node Name="Поля ввода">
                            <Node Name="TextBox"/>
                            <Node Name="PasswordBox"/>
                        </Node>
                    </Node>
                    <Node Name="Контейнеры">
                        <Node Name="StackPanel"/>
                        <Node Name="Grid"/>
                        <Node Name="Canvas"/>
                    </Node>
                </Tree>
            </x:XData>
        </XmlDataProvider>

        <!-- Демо-данные для DataGrid -->
        <XmlDataProvider x:Key="DemoGridData">
            <x:XData>
                <Items xmlns="">
                    <Item Name="Button" Description="Обычная кнопка" Status="Активна"/>
                    <Item Name="TextBox" Description="Поле ввода текста" Status="Пустое"/>
                    <Item Name="ComboBox" Description="Раскрывающийся список" Status="Выбрано"/>
                    <Item Name="CheckBox" Description="Флажок" Status="Отмечен"/>
                </Items>
            </x:XData>
        </XmlDataProvider>
    </Window.Resources>

    <DockPanel>
        <!-- Панель инструментов -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Копировать" Command="{Binding CopyCommand}" Style="{StaticResource ToolBarButtonStyle}"/>
                <Button Content="Вставить" Command="{Binding PasteCommand}" Style="{StaticResource ToolBarButtonStyle}"/>
            </ToolBar>
        </ToolBarTray>

        <TabControl Margin="10">

            <!-- ВКЛАДКА 1: Основное -->
            <TabItem Header="Основное">
                <ScrollViewer>
                    <StackPanel Margin="15">
                        <GroupBox Header="Настройки персонализации" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Тема приложения:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox Text="{Binding SelectedTheme, Mode=TwoWay}" Style="{StaticResource AppInputStyle}">
                                    <ComboBoxItem Content="Светлая тема"/>
                                    <ComboBoxItem Content="Темная тема"/>
                                </ComboBox>

                                <TextBlock Text="Язык приложения:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox Style="{StaticResource AppInputStyle}">
                                    <ComboBoxItem Content="Русский"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Настройки шрифтов" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Шрифт:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox Style="{StaticResource AppInputStyle}">
                                    <ComboBoxItem Content="Segoe UI"/>
                                    <ComboBoxItem Content="Arial"/>
                                    <ComboBoxItem Content="Times New Roman"/>
                                </ComboBox>

                                <TextBlock Text="Размер шрифта:" Style="{StaticResource LabelStyle}"/>
                                <Slider Minimum="10" Maximum="24" Value="{Binding FontSize, Mode=TwoWay}"
                                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding FontSize, StringFormat='Текущий размер: {0}'}"
                                           HorizontalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 2: Цветовая палитра -->
            <TabItem Header="Цветовая палитра">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTheme, StringFormat='Текущая тема: {0}'}"
                                   Style="{StaticResource HeaderTextBlockStyle}"/>

                        <GroupBox Header="Основные цвета" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{StaticResource PrimaryBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="Основной" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{StaticResource AccentBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="Акцентный" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{StaticResource SuccessBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="Успех" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{StaticResource ErrorBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="Ошибка" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="10" HorizontalAlignment="Center">
                                    <Rectangle Width="60" Height="60" Fill="{StaticResource InfoBrush}" RadiusX="5" RadiusY="5"/>
                                    <TextBlock Text="Информация" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Палитра основного цвета (10 оттенков)" Style="{StaticResource AppGroupBoxStyle}">
                            <ItemsControl ItemsSource="{Binding Source={StaticResource PrimaryColors}, XPath=Colors/Color}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{Binding XPath=@Hex}" Width="60" Height="30" Stroke="Gray" RadiusX="3" RadiusY="3"/>
                                            <TextBlock Text="{Binding XPath=@RGB}" Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            <TextBlock Text="{Binding XPath=@Name}" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 3: Элементы управления -->
            <TabItem Header="Элементы управления">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <Expander Header="Кнопки" IsExpanded="True" Margin="0,5">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <Button Content="Обычная" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Всплывающая подсказка"/>
                                <Button Content="Успех" Style="{StaticResource SuccessButtonStyle}"/>
                                <Button Content="Удалить" Style="{StaticResource DangerButtonStyle}"/>
                                <ToggleButton Content="Переключатель" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Поля ввода и списки" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10">
                                <TextBox Text="TextBox: введите текст" Style="{StaticResource AppInputStyle}"/>
                                <PasswordBox Password="secret" Padding="6,4" Margin="0,0,0,10" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Text="ComboBox" IsEditable="True" Width="200" Margin="0,0,10,0" Style="{StaticResource AppInputStyle}"/>
                                    <ListBox Width="200" Height="60">
                                        <ListBoxItem Content="Элемент 1"/>
                                        <ListBoxItem Content="Элемент 2"/>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Текстовые элементы" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10">
                                <TextBlock Text="Заголовок уровня 1" FontSize="24" FontWeight="Bold" Margin="0,5"/>
                                <TextBlock Text="Заголовок уровня 2" FontSize="20" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Text="Обычный текст в TextBlock." Margin="0,5"/>
                                <Label Content="Подпись в Label" BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,5"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="TreeView и DataGrid" IsExpanded="True" Margin="0,5">
                            <StackPanel Margin="10">
                                <TreeView Height="120" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10"
                                          ItemsSource="{Binding Source={StaticResource TreeData}, XPath=Tree/Node}">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding XPath=Node}">
                                            <TextBlock Text="{Binding XPath=@Name}"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <DataGrid Height="120" AutoGenerateColumns="False" IsReadOnly="True"
                                          ItemsSource="{Binding Source={StaticResource DemoGridData}, XPath=Items/Item}"
                                          Style="{StaticResource AppDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Название" Binding="{Binding XPath=@Name}" Width="*"/>
                                        <DataGridTextColumn Header="Описание" Binding="{Binding XPath=@Description}" Width="2*"/>
                                        <DataGridTextColumn Header="Статус" Binding="{Binding XPath=@Status}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>

                        <Expander Header="ProgressBar" IsExpanded="False" Margin="0,5">
                            <StackPanel Margin="10">
                                <ProgressBar Value="65" Height="25" Margin="0,5" Maximum="100"/>
                                <TextBlock Text="Прогресс: 65%" HorizontalAlignment="Center" Margin="0,5"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 4: Контейнеры компоновки -->
            <TabItem Header="Контейнеры компоновки">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <GroupBox Header="StackPanel (Вертикальный)" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Margin="10" Background="#F0F0F0">
                                <Rectangle Fill="{StaticResource ErrorBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Width="60" Height="40" Margin="2"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="StackPanel (Горизонтальный)" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Orientation="Horizontal" Margin="10" Background="#F0F0F0">
                                <Rectangle Fill="{StaticResource ErrorBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Width="60" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Width="60" Height="40" Margin="2"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="WrapPanel (Перенос элементов)" Style="{StaticResource AppGroupBoxStyle}">
                            <WrapPanel Margin="10" Background="#F0F0F0">
                                <Rectangle Fill="{StaticResource ErrorBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource AccentBrush}" Width="80" Height="40" Margin="2"/>
                                <Rectangle Fill="{StaticResource InfoBrush}" Width="80" Height="40" Margin="2"/>
                            </WrapPanel>
                        </GroupBox>

                        <GroupBox Header="DockPanel (Пристыковка к краям)" Style="{StaticResource AppGroupBoxStyle}">
                            <DockPanel Margin="10" Background="#F0F0F0" Height="140">
                                <Rectangle Fill="{StaticResource ErrorBrush}" Width="60" DockPanel.Dock="Left" Margin="2"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Height="40" DockPanel.Dock="Top" Margin="2"/>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Height="40" DockPanel.Dock="Bottom" Margin="2"/>
                                <Rectangle Fill="{StaticResource AccentBrush}" Margin="2"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Header="Grid (Табличная структура)" Style="{StaticResource AppGroupBoxStyle}">
                            <Grid Margin="10" Background="#F0F0F0" Height="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{StaticResource ErrorBrush}" Grid.Row="0" Grid.Column="0" Margin="2"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Grid.Row="0" Grid.Column="1" Margin="2"/>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Grid.Row="1" Grid.Column="0" Margin="2"/>
                                <Rectangle Fill="{StaticResource AccentBrush}" Grid.Row="1" Grid.Column="1" Margin="2"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Canvas (Абсолютное позиционирование)" Style="{StaticResource AppGroupBoxStyle}">
                            <Canvas Margin="10" Background="#F0F0F0" Height="140">
                                <Rectangle Fill="{StaticResource ErrorBrush}" Width="60" Height="40" Canvas.Left="20" Canvas.Top="20"/>
                                <Rectangle Fill="{StaticResource SuccessBrush}" Width="60" Height="40" Canvas.Left="100" Canvas.Top="50"/>
                                <Rectangle Fill="{StaticResource PrimaryBrush}" Width="60" Height="40" Canvas.Left="60" Canvas.Top="90"/>
                            </Canvas>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ВКЛАДКА 5: Таблицы и Команды -->
            <TabItem Header="Таблицы и Команды">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Исходная таблица (Source)" Grid.Column="0" Style="{StaticResource AppGroupBoxStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Content="Добавить" Command="{Binding AddCommand}" Style="{StaticResource SuccessButtonStyle}"/>
                                <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding SourceItems}"
                                      SelectedItem="{Binding SelectedSourceItem}"
                                      Style="{StaticResource AppDataGridStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Header="Целевая таблица (Target)" Grid.Column="1" Style="{StaticResource AppGroupBoxStyle}">
                        <DataGrid ItemsSource="{Binding TargetItems}"
                                  SelectedItem="{Binding SelectedTargetItem}"
                                  Style="{StaticResource AppDataGridStyle}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА 6: Типы привязок -->
            <TabItem Header="Типы привязок">
                <ScrollViewer Margin="15">
                    <StackPanel>
                        <TextBlock Text="Демонстрация режимов обновления источника (UpdateSourceTrigger)"
                                   Style="{StaticResource HeaderTextBlockStyle}"/>

                        <GroupBox Header="1. PropertyChanged (Обновление при каждом символе)" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBox Text="{Binding BindingPropertyChanged, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppInputStyle}"/>
                                <TextBlock Text="{Binding BindingPropertyChanged}" FontStyle="Italic" Foreground="Gray"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="2. LostFocus (Обновление при потере фокуса)" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBox Text="{Binding BindingLostFocus, UpdateSourceTrigger=LostFocus}" Style="{StaticResource AppInputStyle}"/>
                                <TextBlock Text="{Binding BindingLostFocus}" FontStyle="Italic" Foreground="Gray"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="3. Explicit (Явное обновление по кнопке)" Style="{StaticResource AppGroupBoxStyle}">
                            <StackPanel Margin="10">
                                <TextBox Text="{Binding BindingExplicit, UpdateSourceTrigger=Explicit}" Style="{StaticResource AppInputStyle}"/>
                                <Button Content="Обновить явно" Command="{Binding UpdateExplicitCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>